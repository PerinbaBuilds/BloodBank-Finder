DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodbank"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
# Distance, in kilometers, used when matching donors/blood banks to an emergency request
DEFAULT_MATCH_RADIUS_KM=15
# Minimum days required between two whole-blood donations
MIN_DONATION_INTERVAL_DAYS=90
