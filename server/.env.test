# Used only by `npm test` (vitest + supertest). Points at a dedicated local
# database so the automated suite never touches seeded dev data. Contains no
# real secrets - safe to commit.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodbank_test"
PORT=4001
NODE_ENV=test
JWT_SECRET="test-only-secret-do-not-use-in-production-aaaaaaaaaaaa"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
DEFAULT_MATCH_RADIUS_KM=15
MIN_DONATION_INTERVAL_DAYS=90
